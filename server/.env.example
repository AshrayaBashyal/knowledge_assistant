# ==========================================
# Django Core Settings
# ==========================================
SECRET_KEY=your-super-secret-django-key-here
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app
LOG_LEVEL=INFO

# ==========================================
# Database (Neon Serverless PostgreSQL - Permanent Free Tier)
# ==========================================
# Get from neon.tech (0.5GB free forever, no credit card required)
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# LLM & Embeddings (Google Gemini - Free Tier)
# ==========================================
# Get free API key from aistudio.google.com (Free forever, no credit card)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.3
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ==========================================
# Cloud Vector Database Options (Pick ONE - all 100% free, 0 credit card)
# ==========================================

# OPTION 1: Pinecone Serverless (Starter Tier)
# Sign up at pinecone.io (Free Starter tier, no credit card)
# NOTE: If you create the index manually in the UI:
#   - Type: Vector Index (NOT "Document Index" or "Integrated")
#   - Metric: Cosine
#   - Dimension: 768 (matches Gemini text-embedding-004)
#   - Cloud: AWS, Region: us-east-1 (the ONLY free region on Starter)
# NOTE 2: Our code can also auto-create this index for you if it doesn't exist!
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=knowledge-assistant

# OPTION 2: Qdrant Cloud (Alternative Free Cloud Vector DB)
# Sign up at cloud.qdrant.io (1GB permanent free cluster, no credit card)
# QDRANT_URL=https://xxxxxx-xxxx-xxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
# QDRANT_COLLECTION_NAME=knowledge_assistant

# OPTION 3: Local Chroma (Offline / Dev fallback)
# If neither Pinecone nor Qdrant keys are set, it automatically uses local Chroma storage.

# ==========================================
# Cloud File Storage for PDFs (Cloudinary - Permanent Free Tier)
# ==========================================
# Sign up at cloudinary.com (25GB free storage forever, no credit card)
# Prevents PDF files from disappearing when Render free instances restart!
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# If Cloudinary is omitted, it falls back to local server disk storage (media/).

# ==========================================
# Background Tasks & Caching
# ==========================================
# On Render Free Tier, CELERY_TASK_ALWAYS_EAGER=True runs indexing and flashcard tasks
# in-process immediately, requiring ZERO paid Celery worker instances!
CELERY_TASK_ALWAYS_EAGER=True

# Optional: If you want to use external Redis from Upstash (upstash.com, free, no credit card):
# CELERY_REDIS_URL=rediss://default:password@your-redis.upstash.io:6379
# REDIS_CACHE_URL=rediss://default:password@your-redis.upstash.io:6379

# ==========================================
# Optional Integrations
# ==========================================
# Tavily Search (Free 1000 searches/mo at tavily.com)
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=3

# LangSmith LLM Tracing (smith.langchain.com - Free tier)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-assistant

# App Limits
DOCUMENT_MAX_UPLOAD_SIZE_MB=60
CHAT_HISTORY_MAX_MESSAGES=20
RETRIEVAL_TOP_K=4
RESULTS_PER_SOURCE=10
