# ==========================================
# Django Core Settings
# ==========================================
SECRET_KEY=your-super-secret-django-key-here
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://knowledge-assistant-xi.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app
LOG_LEVEL=INFO

# ==========================================
# PostgreSQL database (configure a persistent production database)
# ==========================================
# A blank value uses local SQLite, which is not durable on Render.
DATABASE_URL=

# ==========================================
# LLM & Embeddings (Google Gemini)
# ==========================================
# Gemini API quotas and model access vary by account and can change.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.3
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ==========================================
# Optional Cloud Vector Database (configure one provider and check its limits)
# ==========================================

# OPTION 1: Pinecone Serverless (Starter Tier)
# See Pinecone for current plan, pricing, and limits.
# NOTE: If you create the index manually in the UI:
#   - Type: Vector Index (NOT "Document Index" or "Integrated")
#   - Metric: Cosine
#   - Dimension: 768 (matches this app's Gemini embedding output)
#   - Cloud/region: select a region supported by your Pinecone plan
# NOTE 2: Our code can also auto-create this index for you if it doesn't exist!
PINECONE_API_KEY=
PINECONE_INDEX_NAME=knowledge-assistant

# OPTION 2: Qdrant Cloud (Alternative Free Cloud Vector DB)
# See Qdrant Cloud for current plan, pricing, and limits.
# QDRANT_URL=https://xxxxxx-xxxx-xxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
# QDRANT_COLLECTION_NAME=knowledge_assistant

# OPTION 3: Local Chroma (Offline / Dev fallback)
# If neither Pinecone nor Qdrant keys are set, it automatically uses local Chroma storage.

# ==========================================
# Cloud File Storage for PDFs (Cloudinary)
# ==========================================
# Check Cloudinary for current plan and storage limits.
# Prevents PDF files from disappearing when Render free instances restart!
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# If Cloudinary is omitted, it falls back to local server disk storage (media/).

# ==========================================
# Background Tasks & Caching
# ==========================================
# Eager mode runs indexing and flashcard tasks inside web requests. This avoids
# a separate worker but makes saves/indexing slow; set False and configure Redis
# to run a worker for responsive background processing.
CELERY_TASK_ALWAYS_EAGER=True

# Optional: If you want to use external Redis from Upstash (upstash.com, free, no credit card):
# CELERY_REDIS_URL=rediss://default:password@your-redis.upstash.io:6379
# REDIS_CACHE_URL=rediss://default:password@your-redis.upstash.io:6379
# Redis TLS certificate verification defaults to required.
# REDIS_SSL_CERT_REQS=CERT_REQUIRED

# ==========================================
# Optional Integrations
# ==========================================
# Tavily Search (Free 1000 searches/mo at tavily.com)
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=3

# LangSmith LLM Tracing (smith.langchain.com - Free tier)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-assistant

# App Limits
DOCUMENT_MAX_UPLOAD_SIZE_MB=60
CHAT_HISTORY_MAX_MESSAGES=20
RETRIEVAL_TOP_K=4
RESULTS_PER_SOURCE=10
